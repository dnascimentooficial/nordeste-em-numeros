RewriteEngine On
RewriteCond %{HTTP_HOST} !^nordeste\.dnascimento\.com\.br$ [NC]
RewriteRule ^(.*)$ https://nordeste.dnascimento.com.br/$1 [R=301,L]
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://nordeste.dnascimento.com.br/$1 [R=301,L]
Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; font-src 'self'; frame-ancestors 'none'; base-uri 'self'"
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "DENY"
Header always set Strict-Transport-Security "max-age=31536000"
AddDefaultCharset UTF-8
AddCharset UTF-8 .css .js .json .csv .svg .txt
<FilesMatch "\.(html|css|js|json|csv)$">
Header set Cache-Control "no-cache"
</FilesMatch>
<FilesMatch "\.(png|webp|woff2)$">
Header set Cache-Control "max-age=86400"
</FilesMatch>
